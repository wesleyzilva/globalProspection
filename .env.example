# ─────────────────────────────────────────────
# GLOBAL PROSPECTION — API Keys
# Copy to .env and fill in your keys
# ─────────────────────────────────────────────

# ── Tier 1: Hunter.io (FREE: 25 searches/month)
# Get at: https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key_here

# ── Tier 2: Apollo.io (FREE: 50 credits/month)
# Get at: https://developer.apollo.io/keys/
APOLLO_API_KEY=your_apollo_api_key_here

# ── Tier 3: RocketReach (FREE: 5 lookups/month)
# Get at: https://rocketreach.co/api
ROCKETREACH_API_KEY=your_rocketreach_api_key_here

# ── Tier 4: Clearbit (paid, Enrichment API)
# Get at: https://dashboard.clearbit.com/api
CLEARBIT_API_KEY=your_clearbit_api_key_here

# ── Output settings
OUTPUT_DIR=output
OUTPUT_FILE=prospects.csv
